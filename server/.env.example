PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/elevateai
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
# How many reverse proxies / load balancers sit in front of the API (0 = none). Set this in deploys,
# otherwise every client shares one rate-limit bucket. Never set it higher than the real hop count.
TRUST_PROXY=0
# Outgoing mail. Leave SMTP_URL empty to print mails (with their links) to the server console.
# Local Mailpit from docker-compose: smtp://localhost:1025 (inbox at http://localhost:8025)
SMTP_URL=smtps://yourname%40gmail.com:APP_PASSWORD_NO_SPACES@smtp.gmail.com:465
MAIL_FROM=ElevateAI <yourname@gmail.com>
# Refuse login until the email is verified (true | false)
REQUIRE_EMAIL_VERIFICATION=true
# Google sign-in: set both (or neither; an empty value fails validation) and VITE_GOOGLE_AUTH=true in client/.env.
# Authorized redirect URI in Google Cloud: http://localhost:4000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AI features (resume import). Leave OPENAI_API_KEY empty to disable them (routes answer 503).
OPENAI_API_KEY=
AI_MODEL_EXTRACT=gpt-6.1-sol
# Set to false to switch every AI feature off (they answer 503)
AI_ENABLED=true
# Used only by `bun run db:seed-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Test-only: AI features return canned output instead of calling OpenAI (refused when NODE_ENV=production)
# AI_STUB=false
