generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models. Further models are added per phase (see IMPLEMENTATION_PLAN.md section 3).
// Embedding columns use Unsupported("vector(1536)") and are queried with $queryRaw.

model User {
  id               String            @id
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  role             String            @default("candidate")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  candidateProfile CandidateProfile?
  jobs             Job[]
  company          Company?
  applications     Application[]
  notifications    Notification[]
  resumeEvaluations ResumeEvaluation[]
  gapExplanations   GapExplanation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CatalogKind {
  skill
  certification
  domain
}

enum CatalogStatus {
  approved
  pending
}

// Curated vocabulary for matching. Ids are stable `kind:slug` strings (set by the seed) so
// stored profile/job versions stay valid across environments.
model CatalogTerm {
  id      String         @id
  kind    CatalogKind
  slug    String
  name    String
  status  CatalogStatus  @default(approved)
  aliases CatalogAlias[]

  @@unique([kind, slug])
  @@map("catalogTerm")
}

model CatalogAlias {
  id     String      @id @default(uuid())
  termId String
  term   CatalogTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  kind   CatalogKind
  alias  String

  @@unique([kind, alias])
  @@index([termId])
  @@map("catalogAlias")
}

// One live profile per candidate. Versions are immutable; saving identical content reuses the
// existing row and restore only repoints currentVersionId, so a version always scores the same.
model CandidateProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVersionId String?          @unique
  currentVersion   ProfileVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         ProfileVersion[] @relation("AllVersions")
  // Phone, contact email, city/country and links. Deliberately outside the versions: it is current
  // information (a restore must not bring back an old phone number), editing it must not create a
  // version, and it can be corrected or removed. Never scored.
  contact          Json?
  // Optional photo: like contact it is outside the versions and never scored. Applying copies the id
  // onto the application, so the employer keeps seeing the photo that was submitted.
  photoId          String?
  photo            PhotoBlob?       @relation(fields: [photoId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())

  @@map("candidateProfile")
}

model ProfileVersion {
  id           String            @id @default(uuid())
  profileId    String
  profile      CandidateProfile  @relation("AllVersions", fields: [profileId], references: [id], onDelete: Cascade)
  contentHash  String
  content      Json
  createdAt    DateTime          @default(now())
  currentOf    CandidateProfile? @relation("CurrentVersion")
  applications Application[]

  @@unique([profileId, contentHash])
  @@map("profileVersion")
}

enum JobStatus {
  draft
  active
  closed
}

// Same versioning idea as profiles: edits create immutable JobVersion rows (identical content
// reuses one), so an application can point at the exact requirements it was scored against.
model Job {
  id               String        @id @default(uuid())
  employerId       String
  employer         User          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  status           JobStatus     @default(draft)
  currentVersionId String?       @unique
  currentVersion   JobVersion?   @relation("CurrentJobVersion", fields: [currentVersionId], references: [id])
  versions         JobVersion[]  @relation("AllJobVersions")
  applications     Application[]
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([employerId, createdAt])
  @@index([status, publishedAt])
  @@map("job")
}

model JobVersion {
  id           String        @id @default(uuid())
  jobId        String
  job          Job           @relation("AllJobVersions", fields: [jobId], references: [id], onDelete: Cascade)
  contentHash  String
  content      Json
  createdAt    DateTime      @default(now())
  currentOf    Job?          @relation("CurrentJobVersion")
  applications Application[]

  @@unique([jobId, contentHash])
  @@map("jobVersion")
}

enum ApplicationStatus {
  applied
  under_review
  technical_interview
  culture_fit
  offer
  rejected
  hired
}

// An application freezes the exact profile and job versions it was scored against, plus the
// result, so the score an employer sees never changes when either side is edited later.
// NoAction on the version FKs: deleting a user cascades both the application and the versions
// in one statement, which Restrict would block.
model Application {
  id               String                     @id @default(uuid())
  jobId            String
  job              Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        User                       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  profileVersionId String
  profileVersion   ProfileVersion             @relation(fields: [profileVersionId], references: [id], onDelete: NoAction)
  jobVersionId     String
  jobVersion       JobVersion                 @relation(fields: [jobVersionId], references: [id], onDelete: NoAction)
  status           ApplicationStatus          @default(applied)
  matchScore       Int
  matchBreakdown   Json
  engineVersion    String
  // The employer's own 1-5 opinion; private, never scored, never shown to the candidate.
  rating           Int?
  summary          String?
  summaryModel     String?
  summaryVersion   Int?
  // The candidate's photo as of applying (frozen: the blob is immutable). Employer-only.
  photoId          String?
  photo            PhotoBlob?                 @relation(fields: [photoId], references: [id], onDelete: Restrict)
  history          ApplicationStatusHistory[]
  notes            ApplicationNote[]
  notifications    Notification[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId, matchScore(sort: Desc)])
  @@index([candidateId, createdAt])
  @@map("application")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
  @@map("applicationStatusHistory")
}

// Immutable, content-addressed image (id = sha256 of the bytes). Profiles and applications point at it;
// it is deleted once nothing does.
model PhotoBlob {
  id           String             @id
  contentType  String
  data         Bytes
  createdAt    DateTime           @default(now())
  profiles     CandidateProfile[]
  applications Application[]

  @@map("photoBlob")
}

// Private employer notes on an application. Never returned by a candidate endpoint.
model ApplicationNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@map("applicationNote")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// The public face of an employer. One per employer account. Text content is current information
// (editable, not versioned, never scored). `verified` is set only by an admin.
model Company {
  id           String         @id @default(uuid())
  ownerId      String         @unique
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  tagline      String         @default("")
  about        String         @default("")
  mission      String         @default("")
  headquarters String         @default("")
  size         String         @default("")
  fundingStage String         @default("")
  foundedYear  Int?
  website      String         @default("")
  links        Json           @default("{}")
  culture      Json           @default("[]")
  benefits     Json           @default("[]")
  hubs         Json           @default("[]")
  awards       Json           @default("[]")
  domainId     String?
  workPolicy   String?
  verified     Boolean        @default(false)
  images       CompanyImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([domainId])
  @@map("company")
}

// Logo and cover bytes live in Postgres (small, capped). Access goes through company.images.ts so
// object storage can replace it without touching callers.
model CompanyImage {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String
  contentType String
  data        Bytes
  etag        String
  updatedAt   DateTime @updatedAt

  @@unique([companyId, kind])
  @@map("companyImage")
}

enum NotificationType {
  application_status
  application_received
}

// In-app inbox entry. Title, body and link are written when the event happens (the link is always an
// internal path built by the server), so an entry stays readable if the job is later edited.
model Notification {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  body          String
  link          String
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notification")
}

/// AI review of a candidate's saved resume (advice only, never scored or shown to employers).
/// One row per (user, resume content hash, rubric version), so the same content is never re-evaluated.
model ResumeEvaluation {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentHash   String
  rubricVersion Int
  result        Json
  model         String
  createdAt     DateTime @default(now())

  @@unique([userId, contentHash, rubricVersion])
  @@index([userId, createdAt])
  @@map("resumeEvaluation")
}

/// AI-written note on a candidate gap for a job (advice only). One row per profile version, job version,
/// engine version and prompt version, so the same inputs are never explained twice.
model GapExplanation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVersionId String
  jobVersionId     String
  engineVersion    String
  promptVersion    Int
  result           Json
  model            String
  createdAt        DateTime @default(now())

  @@unique([userId, profileVersionId, jobVersionId, engineVersion, promptVersion], map: "gapExplanation_key")
  @@index([userId, createdAt])
  @@map("gapExplanation")
}
