# Copy to server/.env.production (gitignored). Production checklist: every line below must be set.
NODE_ENV=production            # turns on rate limiting and secure cookies (needs HTTPS)
# TRUST_PROXY is set to 1 by docker-compose.prod.yml (Caddy = one hop). Never use "true".
# One origin: the client calls relative /api, so both URLs are the public https address.
CLIENT_ORIGIN=https://example.com
BETTER_AUTH_URL=https://example.com
# Must use the same password as POSTGRES_PASSWORD in the shell/.env that runs compose.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/elevateai
REDIS_URL=redis://redis:6379/0
# bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Real SMTP is required: without SMTP_URL mails (verification, reset) only print to the console.
SMTP_URL=
MAIL_FROM=ElevateAI <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=true
# Set OPENAI_API_KEY, or AI_ENABLED=false. Never set AI_STUB (the server refuses it in production).
# OPENAI_API_KEY=
# AI_ENABLED=false
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET= (both or neither; redirect URI <BETTER_AUTH_URL>/api/auth/callback/google)
# First admin: set both, then run db:seed-admin (or leave set, the server seeds on startup).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
